<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AlbumController" prefWidth="800" prefHeight="600">
    <top>
        <HBox spacing="10" padding="10">
            <Button text="Add Photo" onAction="#addPhoto"/>
            <Button text="Remove Photo" onAction="#removePhoto"/>
            <TextField fx:id="captionField" promptText="Enter caption"/>
            <Button text="Update Caption" onAction="#updateCaption"/>
        </HBox>
    </top>
    <center>
        <ListView fx:id="photoList"/>
    </center>
</BorderPane>
